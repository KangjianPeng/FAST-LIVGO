<launch>

	<arg name="rviz" default="true" />

	<rosparam command="load" file="$(find fast_livgo)/config/HILTI22.yaml" />

	<node pkg="fast_livgo" type="fastlivgo_mapping" name="laserMapping" output="screen">
		<rosparam file="$(find fast_livgo)/config/camera_fisheye_HILTI22.yaml" />
	</node>

	<group if="$(arg rviz)">
		<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_livgo)/rviz_cfg/hilti.rviz" />
	</group>
</launch>
